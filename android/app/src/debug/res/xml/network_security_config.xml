<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTP عادي مسموح للتطوير المحلي بس.

  أندرويد من API 28 بيقفل الـcleartext افتراضيًا، والباك-إند المحلي
  (`php artisan serve`) بيشتغل HTTP مش HTTPS. الملف ده في `src/debug/`
  فبيتطبّق على بيلد الديبج لوحده — الـrelease مابيشوفهوش أصلاً.

  10.0.2.2 هو المنفذ اللي محاكي الأندرويد بيوصل بيه لـloopback المضيف.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
